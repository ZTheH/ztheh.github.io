---
import { profile, links, cv } from '../data/profile';
const hubs = [
  { label: 'Projects', desc: '4 builds · 1 open source', href: '#projects' },
  { label: 'About', desc: 'IT foundations → security', href: '#about' },
  { label: 'Skills', desc: 'networking · security · dev', href: '#skills' },
  { label: 'Labs', desc: 'write-ups in progress', href: '#labs' },
  { label: 'Experience', desc: 'CCNA · PIGIER · MSc', href: '#experience' },
  { label: 'Contact', desc: 'open to opportunities', href: '#contact' },
];
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true"><canvas id="net" data-hubs={JSON.stringify(hubs)}></canvas></div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="status-line reveal">
        <span class="dot" aria-hidden="true"></span>
        {profile.statusLine.map((s, i) => (<>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          <span>{s}</span>
        </>))}
      </div>
      <div class="name reveal" style="--d:60ms">{profile.name} — {profile.location}</div>
      <h1 id="hero-title" class="reveal" style="--d:120ms">
        {profile.headline[0]}
        <span class="l2">{profile.headline[1].replace('.', '')}<em>.</em></span>
      </h1>
      <p class="intro reveal" style="--d:200ms">{profile.intro}</p>
      <div class="hero-links reveal" style="--d:280ms">
        <a href={links.github} target="_blank" rel="noopener noreferrer">github ↗</a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">linkedin ↗</a>
        <a href={`mailto:${links.email}`}>email ↗</a>
        {cv.available && <a href={cv.file} download>cv ↓</a>}
      </div>
    </div>
  </div>
  <div class="hero-hint" aria-hidden="true"><span>drag any node</span><span>click a hub to jump</span><span>click empty space to ping</span></div>
</section>

<script>
  import { startNetwork } from '../scripts/network';
  const c = document.getElementById('net') as HTMLCanvasElement | null;
  if (c) startNetwork(c, JSON.parse(c.dataset.hubs || '[]'));
</script>
