---
import { profile, links, cv } from '../data/profile';
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true"><canvas id="net"></canvas></div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="status-line reveal">
        <span class="dot" aria-hidden="true"></span>
        {profile.statusLine.map((s, i) => (<>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <span>{s}</span>
        </>))}
      </div>
      <div class="name reveal" style="--d:60ms">{profile.name}</div>
      <h1 id="hero-title" class="reveal" style="--d:120ms">
        {profile.headline[0]}
        <span class="l2">{profile.headline[1].replace('.', '')}<em>.</em></span>
      </h1>
      <p class="intro reveal" style="--d:200ms">{profile.intro}</p>
      <div class="cta-row reveal" style="--d:280ms">
        <a class="btn primary" href="#projects">Explore My Work <span class="arr">→</span></a>
        <a class="btn" href="#contact">Get in Touch</a>
        {cv.available && <a class="btn" href={cv.file} download>Download CV ↓</a>}
      </div>
      <div class="socials reveal" style="--d:340ms">
        <a href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>
  <div class="hero-hint" aria-hidden="true"><span><i></i>host</span><span><i class="o"></i>probe radius · move your cursor</span></div>
</section>

<script>
  import { startNetwork } from '../scripts/network';
  const c = document.getElementById('net') as HTMLCanvasElement | null;
  if (c) startNetwork(c);
</script>
