---
import { profile, cv } from '../data/profile';
const items = [
  ['Home', '/#home'],
  ['Projects', '/#projects'],
  ['About', '/#about'],
  ['Skills', '/#skills'],
  ['Cybersecurity Labs', '/#labs'],
  ['Experience', '/#experience'],
  ['Contact', '/#contact'],
];
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href="/#home" aria-label={`${profile.name} — home`}>
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="1" y="1" width="38" height="38" rx="9" fill="none" stroke="#3be8bd" stroke-width="1.5" />
        <path d="M11 12h18L11 28h18" fill="none" stroke="#e8eff2" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="29" cy="12" r="2.4" fill="#3be8bd" />
        <circle cx="11" cy="28" r="2.4" fill="#3be8bd" />
      </svg>
      <span>{profile.name}</span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
      <span class="bars"></span>
    </button>
    <nav class="nav-links" id="nav-links" aria-label="Primary">
      {items.map(([label, href]) => <a class="link" href={href} data-section={href.split('#')[1]}>{label}</a>)}
      {cv.available && <a class="btn primary cv" href={cv.file} download>Download CV <span class="arr">↓</span></a>}
    </nav>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>
